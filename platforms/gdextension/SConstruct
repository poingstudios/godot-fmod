import os

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.3"})

fmod_sdk_dir = "thirdparty/fmod"

# FMOD Include directories
fmod_inc_dirs = [
    "src/",
    os.path.join(fmod_sdk_dir, "api/core/inc"),
    os.path.join(fmod_sdk_dir, "api/studio/inc"),
    os.path.join(fmod_sdk_dir, "core/inc"),
    os.path.join(fmod_sdk_dir, "studio/inc"),
    os.path.join(fmod_sdk_dir, "inc"),
]

env.Append(CPPPATH=[p for p in fmod_inc_dirs if os.path.exists(p) or "src" in p])

# Platform specific library paths & linkage
platform = env["platform"]
target = env["target"]
arch = env["arch"]

out_dir = "../godot_editor/addons/fmod/bin"

if platform == "macos":
    lib_search = [
        os.path.join(fmod_sdk_dir, "api/core/lib"),
        os.path.join(fmod_sdk_dir, "api/studio/lib"),
        os.path.join(fmod_sdk_dir, "core/lib"),
        os.path.join(fmod_sdk_dir, "studio/lib"),
        os.path.join(fmod_sdk_dir, "lib"),
        out_dir,
    ]
    env.Append(LIBPATH=[p for p in lib_search if os.path.exists(p)])
    env.Append(LIBS=["fmod", "fmodstudio"])
    env.Append(LINKFLAGS=["-Wl,-rpath,@loader_path"])

elif platform == "windows":
    win_arch = "x64" if arch == "x86_64" else "arm64" if arch == "arm64" else "x86"
    lib_search = [
        os.path.join(fmod_sdk_dir, "api/core/lib", win_arch),
        os.path.join(fmod_sdk_dir, "api/studio/lib", win_arch),
        os.path.join(fmod_sdk_dir, "core/lib", win_arch),
        os.path.join(fmod_sdk_dir, "studio/lib", win_arch),
        os.path.join(fmod_sdk_dir, "lib", win_arch),
        out_dir,
    ]
    env.Append(LIBPATH=[p for p in lib_search if os.path.exists(p)])
    env.Append(LIBS=["fmod_vc", "fmodstudio_vc"])

elif platform == "linux":
    linux_arch = "x86_64" if arch == "x86_64" else "arm64" if arch == "arm64" else "x86"
    lib_search = [
        os.path.join(fmod_sdk_dir, "api/core/lib", linux_arch),
        os.path.join(fmod_sdk_dir, "api/studio/lib", linux_arch),
        os.path.join(fmod_sdk_dir, "core/lib", linux_arch),
        os.path.join(fmod_sdk_dir, "studio/lib", linux_arch),
        os.path.join(fmod_sdk_dir, "lib", linux_arch),
        out_dir,
    ]
    env.Append(LIBPATH=[p for p in lib_search if os.path.exists(p)])
    env.Append(LIBS=["fmod", "fmodstudio"])
    env.Append(LINKFLAGS=["-Wl,-rpath,'$$ORIGIN'"])

# Source files
sources = Glob("src/*.cpp") + Glob("src/**/*.cpp")

if platform == "macos":
    library = env.SharedLibrary(
        "{}/libgodot_fmod.{}.{}.{}.dylib".format(out_dir, platform, target, arch),
        source=sources,
    )
elif platform == "windows":
    library = env.SharedLibrary(
        "{}/libgodot_fmod.{}.{}.{}.dll".format(out_dir, platform, target, arch),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "{}/libgodot_fmod.{}.{}.{}.so".format(out_dir, platform, target, arch),
        source=sources,
    )

env.NoCache(library)
Default(library)
