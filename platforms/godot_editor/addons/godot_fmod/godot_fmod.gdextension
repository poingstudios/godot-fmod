[configuration]
entry_symbol = "godot_fmod_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]
macos.debug.arm64 = "res://addons/godot_fmod/bin/libgodot_fmod.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://addons/godot_fmod/bin/libgodot_fmod.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://addons/godot_fmod/bin/libgodot_fmod.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/godot_fmod/bin/libgodot_fmod.macos.template_release.x86_64.dylib"
windows.debug.x86_64 = "res://addons/godot_fmod/bin/libgodot_fmod.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godot_fmod/bin/libgodot_fmod.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://addons/godot_fmod/bin/libgodot_fmod.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/godot_fmod/bin/libgodot_fmod.windows.template_release.arm64.dll"
linux.debug.x86_64 = "res://addons/godot_fmod/bin/libgodot_fmod.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/godot_fmod/bin/libgodot_fmod.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/godot_fmod/bin/libgodot_fmod.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/godot_fmod/bin/libgodot_fmod.linux.template_release.arm64.so"
